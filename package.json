{
  "name": "af4",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "npm run typecheck && npm run build-only",
    "deploy": "npm run typecheck && npm run build-only && post-build.bat",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build-only": "vite build",
    "typecheck": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "oxfmt src",
    "agent:lint": "oxlint -f unix src && eslint --no-color src --cache",
    "agent:test": "vitest run --no-color --reporter=agent",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "autolinker": "^4.1.5",
    "bind-keys": "github:pongo/bind-keys",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "klona": "^2.0.6",
    "nanoid": "^5.1.11",
    "reka-ui": "^2.9.9",
    "smart-invariant": "^2.0.0",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0",
    "vue3-toastify": "^0.2.8"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.14",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/eslint-plugin": "^1.6.19",
    "@vitest/ui": "^4.1.8",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.68.0",
    "eslint-plugin-vue": "~10.9.2",
    "fake-indexeddb": "^6.2.5",
    "jiti": "^2.7.0",
    "jsdom": "^28.1.0",
    "lint-staged": "^17.0.7",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.54.0",
    "oxlint": "~1.68.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
